From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: evaluating-cli <noreply@github.com>
Date: Sun, 9 Aug 2026 17:15:00 +0200
Subject: [PATCH 1/3] simx86: add executable-scoped validator stepping hook

Add the first stage of the dis86 validator runtime hook.

The hook is fail-closed and activates only at the exact MZ entry point for
the requested DOS program after validating the PSP, its owning MCB, and the
program path recorded in the PSP environment block.

Once active it forces simx86 MSSTP mode, synchronizes register state through
a page-sized /hydra_remote POSIX shared-memory object, reports the actual
translated-node instruction count from TNode.seqnum, and acknowledges an end
request before allowing another guest node to begin.

This patch intentionally does not export lowmem_base or solve child-process
scope/target-termination teardown; those are separate follow-up patches.

Base: dosemu2/dosemu2@604ce0cdd1a71f657e2a2df623d216d5ab289313
---
 src/base/emu-i386/simx86/Makefile         |   2 +-
 src/base/emu-i386/simx86/diis-validator.c | 348 ++++++++++++++++++++++
 src/base/emu-i386/simx86/diis-validator.h |  20 ++
 src/base/emu-i386/simx86/interp.c         |  24 ++
 4 files changed, 385 insertions(+), 1 deletion(-)
 create mode 100644 src/base/emu-i386/simx86/diis-validator.c
 create mode 100644 src/base/emu-i386/simx86/diis-validator.h

diff --git a/src/base/emu-i386/simx86/Makefile b/src/base/emu-i386/simx86/Makefile
--- a/src/base/emu-i386/simx86/Makefile
+++ b/src/base/emu-i386/simx86/Makefile
@@ -13,7 +13,7 @@ ifeq ($(X86_JIT),1)
 JITFILES = codegen-x86.c fp87-x86.c sigsegv.c cpatch.c
 endif
 CFILES = interp.c cpu-emu.c modrm-gen.c $(JITFILES) \
-	codegen-sim.c fp87-sim.c protmode.c tables.c \
+	codegen-sim.c fp87-sim.c protmode.c tables.c diis-validator.c \
 	codegen.c trees.c memory.c codebuf.c
 ALL_CPPFLAGS +=-I$(EM86DIR) $(EM86FLG)

diff --git a/src/base/emu-i386/simx86/diis-validator.h b/src/base/emu-i386/simx86/diis-validator.h
new file mode 100644
--- /dev/null
+++ b/src/base/emu-i386/simx86/diis-validator.h
@@ -0,0 +1,19 @@
+#ifndef _EMU86_DIIS_VALIDATOR_H
+#define _EMU86_DIIS_VALIDATOR_H
+
+#define DIIS_VALIDATOR_ABI_VERSION 1u
+
+enum {
+	DIIS_STEP_MULTI_INSN = 1u << 0,
+	DIIS_STEP_SAME_PC = 1u << 1,
+	DIIS_STEP_FAULT = 1u << 2,
+	DIIS_STEP_END_ACK = 1u << 3,
+};
+
+/* 0 = disabled/not active, 1 = active, -1 = stop before next node. */
+int diis_validator_before_node(unsigned int *pc);
+
+void diis_validator_after_node(unsigned int start_pc, unsigned int next_pc,
+		unsigned int decoded_instructions, int cpu_err);
+
+#endif
diff --git a/src/base/emu-i386/simx86/diis-validator.c b/src/base/emu-i386/simx86/diis-validator.c
new file mode 100644
--- /dev/null
+++ b/src/base/emu-i386/simx86/diis-validator.c
@@ -0,0 +1,348 @@
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "emu86.h"
+#include "codegen.h"
+#include "diis-validator.h"
+#include "memory.h"
+#include "protmode.h"
+#include "utilities.h"
+
+#define DIIS_SHM_NAME "/hydra_remote"
+#define DIIS_PATH_MAX 260
+#define DIIS_ENV_SCAN_MAX 32768
+
+struct diis_validator_shm {
+	uint32_t abi_version;
+	uint32_t struct_size;
+	uint32_t init;
+	uint32_t end;
+	int32_t pid;
+	uint16_t runtime_psp;
+	uint16_t reserved0;
+	uint64_t req;
+	uint64_t ack;
+	uint32_t decoded_instructions;
+	uint32_t step_flags;
+	uint16_t ax, bx, cx, dx;
+	uint16_t si, di, bp, sp;
+	uint16_t ip, cs, ds, es, ss, flags;
+	uint32_t reserved1;
+};
+
+_Static_assert(offsetof(struct diis_validator_shm, req) == 24,
+		"validator ABI req offset");
+_Static_assert(offsetof(struct diis_validator_shm, ack) == 32,
+		"validator ABI ack offset");
+_Static_assert(offsetof(struct diis_validator_shm, decoded_instructions) == 40,
+		"validator ABI metadata offset");
+_Static_assert(sizeof(struct diis_validator_shm) == 80,
+		"validator ABI size");
+
+static struct diis_validator_shm *g_shm;
+static size_t g_map_size;
+static int g_config_checked;
+static int g_enabled;
+static int g_created;
+static int g_active;
+static uint16_t g_mz_cs;
+static uint16_t g_mz_ip;
+static uint16_t g_runtime_psp;
+static char *g_target_dos_path;
+
+static void diis_validator_cleanup(void)
+{
+	if (g_shm && g_shm != MAP_FAILED)
+		munmap(g_shm, g_map_size);
+	g_shm = NULL;
+	if (g_created)
+		shm_unlink(DIIS_SHM_NAME);
+	g_created = 0;
+	free(g_target_dos_path);
+	g_target_dos_path = NULL;
+}
+
+static int parse_u16_env(const char *name, uint16_t *out)
+{
+	const char *s = getenv(name);
+	char *end;
+	unsigned long v;
+
+	if (!s || !*s)
+		return -1;
+	errno = 0;
+	v = strtoul(s, &end, 0);
+	if (errno || *end || v > 0xffff)
+		return -1;
+	*out = (uint16_t)v;
+	return 0;
+}
+
+static int diis_validator_init(void)
+{
+	const char *enabled;
+	const char *target;
+	long page_size;
+	int fd;
+
+	if (g_config_checked)
+		return g_enabled;
+	g_config_checked = 1;
+
+	enabled = getenv("DIIS_DOSEMU_VALIDATOR");
+	if (!enabled || strcmp(enabled, "1") != 0)
+		return 0;
+
+	if (!CONFIG_CPUSIM) {
+		error("DIIS validator requires $_cpuemu = (1)\n");
+		return 0;
+	}
+
+	target = getenv("DIIS_DOSEMU_TARGET_DOS_PATH");
+	if (!target || !*target ||
+			parse_u16_env("DIIS_DOSEMU_MZ_CS", &g_mz_cs) ||
+			parse_u16_env("DIIS_DOSEMU_MZ_IP", &g_mz_ip)) {
+		error("DIIS validator target identity is incomplete\n");
+		return 0;
+	}
+	g_target_dos_path = strdup(target);
+	if (!g_target_dos_path)
+		return 0;
+
+	page_size = sysconf(_SC_PAGESIZE);
+	if (page_size <= 0 ||
+			sizeof(struct diis_validator_shm) > (size_t)page_size) {
+		error("DIIS validator cannot determine a usable page size\n");
+		goto fail;
+	}
+	g_map_size = (size_t)page_size;
+
+	fd = shm_open(DIIS_SHM_NAME, O_RDWR | O_CREAT | O_EXCL, 0600);
+	if (fd == -1) {
+		error("DIIS validator shm_open(%s): %s\n",
+				DIIS_SHM_NAME, strerror(errno));
+		goto fail;
+	}
+	g_created = 1;
+	if (ftruncate(fd, (off_t)g_map_size) == -1) {
+		error("DIIS validator ftruncate: %s\n", strerror(errno));
+		close(fd);
+		goto fail;
+	}
+	g_shm = mmap(NULL, g_map_size, PROT_READ | PROT_WRITE,
+			MAP_SHARED, fd, 0);
+	close(fd);
+	if (g_shm == MAP_FAILED) {
+		g_shm = NULL;
+		error("DIIS validator mmap: %s\n", strerror(errno));
+		goto fail;
+	}
+
+	memset(g_shm, 0, g_map_size);
+	g_shm->abi_version = DIIS_VALIDATOR_ABI_VERSION;
+	g_shm->struct_size = sizeof(*g_shm);
+	g_shm->pid = getpid();
+	atexit(diis_validator_cleanup);
+	g_enabled = 1;
+	return 1;
+
+fail:
+	diis_validator_cleanup();
+	return 0;
+}
+
+static unsigned char norm_path_char(unsigned char c)
+{
+	if (c == '/')
+		c = '\\';
+	return (unsigned char)toupper(c);
+}
+
+static int guest_path_matches(dosaddr_t addr)
+{
+	size_t i;
+	const dosaddr_t lim = LOWMEM_SIZE + HMASIZE;
+
+	for (i = 0; i < DIIS_PATH_MAX && addr + i < lim; i++) {
+		unsigned char guest = LOWMEM_READ_BYTE(addr + i);
+		unsigned char expected = (unsigned char)g_target_dos_path[i];
+
+		if (norm_path_char(guest) != norm_path_char(expected))
+			return 0;
+		if (!guest)
+			return expected == 0;
+		if (!expected)
+			return 0;
+	}
+	return 0;
+}
+
+static int psp_program_identity_matches(uint16_t psp)
+{
+	dosaddr_t base = (dosaddr_t)psp << 4;
+	dosaddr_t p;
+	const dosaddr_t lim = LOWMEM_SIZE + HMASIZE;
+	uint16_t env_seg;
+	unsigned int scanned;
+
+	if (base + 0x2d >= lim)
+		return 0;
+	if (LOWMEM_READ_BYTE(base) != 0xcd ||
+			LOWMEM_READ_BYTE(base + 1) != 0x20)
+		return 0;
+
+	if (psp == 0)
+		return 0;
+	p = (dosaddr_t)(psp - 1) << 4;
+	if (p + 2 >= lim || LOWMEM_READ_WORD(p + 1) != psp)
+		return 0;
+
+	env_seg = LOWMEM_READ_WORD(base + 0x2c);
+	if (!env_seg)
+		return 0;
+	p = (dosaddr_t)env_seg << 4;
+
+	for (scanned = 0;
+			scanned < DIIS_ENV_SCAN_MAX && p + 1 < lim;
+			scanned++, p++) {
+		if (LOWMEM_READ_BYTE(p) == 0 &&
+				LOWMEM_READ_BYTE(p + 1) == 0) {
+			p += 2;
+			if (p + 2 >= lim || LOWMEM_READ_WORD(p) < 1)
+				return 0;
+			p += 2;
+			return guest_path_matches(p);
+		}
+	}
+	return 0;
+}
+
+static int target_entry_matches(unsigned int pc)
+{
+	uint16_t psp;
+	uint16_t expected_cs;
+	uint16_t ip;
+
+	if (PROTMODE())
+		return 0;
+	if (TheCPU.ds != TheCPU.es)
+		return 0;
+
+	psp = TheCPU.ds;
+	ip = (uint16_t)(pc - LONG_CS);
+	expected_cs = (uint16_t)(psp + 0x10 + g_mz_cs);
+	if (TheCPU.cs != expected_cs || ip != g_mz_ip)
+		return 0;
+	return psp_program_identity_matches(psp);
+}
+
+static void publish_cpu(unsigned int pc, uint32_t decoded, uint32_t flags)
+{
+	g_shm->ax = (uint16_t)TheCPU.eax;
+	g_shm->bx = (uint16_t)TheCPU.ebx;
+	g_shm->cx = (uint16_t)TheCPU.ecx;
+	g_shm->dx = (uint16_t)TheCPU.edx;
+	g_shm->si = (uint16_t)TheCPU.esi;
+	g_shm->di = (uint16_t)TheCPU.edi;
+	g_shm->bp = (uint16_t)TheCPU.ebp;
+	g_shm->sp = (uint16_t)TheCPU.esp;
+	g_shm->ip = (uint16_t)(pc - LONG_CS);
+	g_shm->cs = TheCPU.cs;
+	g_shm->ds = TheCPU.ds;
+	g_shm->es = TheCPU.es;
+	g_shm->ss = TheCPU.ss;
+	g_shm->flags = (uint16_t)TheCPU.eflags;
+	g_shm->runtime_psp = g_runtime_psp;
+	g_shm->decoded_instructions = decoded;
+	g_shm->step_flags = flags;
+}
+
+static void apply_cpu(unsigned int *pc)
+{
+	TheCPU.eax = (TheCPU.eax & 0xffff0000u) | g_shm->ax;
+	TheCPU.ebx = (TheCPU.ebx & 0xffff0000u) | g_shm->bx;
+	TheCPU.ecx = (TheCPU.ecx & 0xffff0000u) | g_shm->cx;
+	TheCPU.edx = (TheCPU.edx & 0xffff0000u) | g_shm->dx;
+	TheCPU.esi = (TheCPU.esi & 0xffff0000u) | g_shm->si;
+	TheCPU.edi = (TheCPU.edi & 0xffff0000u) | g_shm->di;
+	TheCPU.ebp = (TheCPU.ebp & 0xffff0000u) | g_shm->bp;
+	TheCPU.esp = (TheCPU.esp & 0xffff0000u) | g_shm->sp;
+	TheCPU.eflags = (TheCPU.eflags & 0xffff0000u) | g_shm->flags;
+
+	if (TheCPU.cs != g_shm->cs)
+		SetSegReal(g_shm->cs, Ofs_CS);
+	if (TheCPU.ds != g_shm->ds)
+		SetSegReal(g_shm->ds, Ofs_DS);
+	if (TheCPU.es != g_shm->es)
+		SetSegReal(g_shm->es, Ofs_ES);
+	if (TheCPU.ss != g_shm->ss)
+		SetSegReal(g_shm->ss, Ofs_SS);
+
+	TheCPU.eip = g_shm->ip;
+	*pc = LONG_CS + TheCPU.eip;
+	TheCPU.key = *pc;
+}
+
+int diis_validator_before_node(unsigned int *pc)
+{
+	uint64_t req;
+	uint64_t ack;
+
+	if (!diis_validator_init())
+		return 0;
+
+	if (!g_active) {
+		if (!target_entry_matches(*pc))
+			return 0;
+		g_runtime_psp = TheCPU.ds;
+		g_active = 1;
+		publish_cpu(*pc, 0, 0);
+		__atomic_store_n(&g_shm->init, 1, __ATOMIC_RELEASE);
+	}
+
+	for (;;) {
+		if (__atomic_load_n(&g_shm->end, __ATOMIC_ACQUIRE)) {
+			publish_cpu(*pc, 0, DIIS_STEP_END_ACK);
+			req = __atomic_load_n(&g_shm->req, __ATOMIC_RELAXED);
+			__atomic_store_n(&g_shm->ack, req, __ATOMIC_RELEASE);
+			return -1;
+		}
+		req = __atomic_load_n(&g_shm->req, __ATOMIC_ACQUIRE);
+		ack = __atomic_load_n(&g_shm->ack, __ATOMIC_RELAXED);
+		if (req != ack)
+			break;
+		usleep(50);
+	}
+
+	apply_cpu(pc);
+	return 1;
+}
+
+void diis_validator_after_node(unsigned int start_pc, unsigned int next_pc,
+		unsigned int decoded_instructions, int cpu_err)
+{
+	uint32_t flags = 0;
+	uint64_t req;
+
+	if (!g_active)
+		return;
+	if (decoded_instructions > 1)
+		flags |= DIIS_STEP_MULTI_INSN;
+	if (next_pc == start_pc)
+		flags |= DIIS_STEP_SAME_PC;
+	if (cpu_err)
+		flags |= DIIS_STEP_FAULT;
+
+	publish_cpu(next_pc, decoded_instructions, flags);
+	req = __atomic_load_n(&g_shm->req, __ATOMIC_RELAXED);
+	__atomic_store_n(&g_shm->ack, req, __ATOMIC_RELEASE);
+}
diff --git a/src/base/emu-i386/simx86/interp.c b/src/base/emu-i386/simx86/interp.c
--- a/src/base/emu-i386/simx86/interp.c
+++ b/src/base/emu-i386/simx86/interp.c
@@ -40,6 +40,7 @@
 #include "mhpdbg.h"
 #include "video.h"
 #include "utilities.h"
+#include "diis-validator.h"
 
 #if PROFILE
 int EmuSignals = 0;
@@ -428,10 +429,20 @@ static unsigned int FindExecCode(unsigned int PC)
 	 * any signal processing. Jumps are defined as
 	 * a 'descheduling point' for checking signals.
 	 */
 	while (1) {
+		int diis_state;
+
 		TheCPU.mode &= ~(MSSTP|MTRAP);
 		if (EFLAGS & TF)
 			TheCPU.mode |= MSSTP|MTRAP;
+		diis_state = diis_validator_before_node(&PC);
+		if (diis_state < 0) {
+			TheCPU.err = EXCP_GOBACK;
+			leavedos_main(0);
+			return PC;
+		}
+		if (diis_state > 0)
+			TheCPU.mode |= MSSTP;
 		G = NULL;
 		if (e_querynode(PC)) {
 			G = FindTree(PC);
@@ -476,5 +487,8 @@ static unsigned int FindExecCode(unsigned int PC)
 		}
 		/* ---- this is the MAIN EXECUTE point ---- */
+		unsigned int diis_start_pc = G->key;
+		unsigned int diis_decoded_instructions = G->seqnum;
+
 		NodesExecd++;
 #if PROFILE
 		TotalNodesExecd++;
@@ -490,6 +505,9 @@ static unsigned int FindExecCode(unsigned int PC)
 #endif
 		PC = DoExec(G);
 		// G is unreliable (maybe deleted) past this point!
+		diis_validator_after_node(diis_start_pc, PC,
+				diis_decoded_instructions, TheCPU.err);
+
 #if SPEC_PREJIT
 		if (speculate) {
 			prejit_sync();
-- 
