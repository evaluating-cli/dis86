From 0000000000000000000000000000000000000002 Mon Sep 17 00:00:00 2001
From: evaluating-cli <noreply@github.com>
Date: Sun, 9 Aug 2026 17:32:00 +0200
Subject: [PATCH 2/3] mapping: export validator lowmem backing

When the dis86 validator is enabled, require the POSIX SHM mapping driver and
keep the low-memory backing object named as /dosemu_mem instead of unlinking
it immediately.

The named object is the same fd used by alloc_mapping_file() to create the
MAPPING_LOWMEM allocation that mapping.c stores in lowmem_base. Before the
mapping is accepted, create a temporary second MAP_SHARED view and verify
writes in both directions, restoring the original bytes afterwards.

Before publishing the validator control ABI, also verify that mapshm is the
selected mapping driver, the named object is the verified lowmem allocation,
and the live low-memory alias for address zero resolves to lowmem_base.

This avoids a second copy of DOS memory and makes /dosemu_mem an externally
mappable view of the same backing simx86 uses.

Base: patch 1 on dosemu2/dosemu2@604ce0cdd1a71f657e2a2df623d216d5ab289313
---
diff --git a/src/base/emu-i386/simx86/diis-validator.c b/src/base/emu-i386/simx86/diis-validator.c
--- a/src/base/emu-i386/simx86/diis-validator.c
+++ b/src/base/emu-i386/simx86/diis-validator.c
@@ -13,6 +13,7 @@
 #include "emu86.h"
 #include "codegen.h"
 #include "diis-validator.h"
 #include "memory.h"
+#include "mapping/mapping.h"
 #include "protmode.h"
 #include "utilities.h"
@@ -103,6 +104,12 @@ static int diis_validator_init(void)
 		error("DIIS validator requires $_cpuemu = (1)\n");
 		return 0;
 	}
+	if (!mapping_validator_lowmem_export_ready()) {
+		error("DIIS validator requires verified mapshm low memory "
+				"export at /dosemu_mem\n");
+		return 0;
+	}
+
 
 	target = getenv("DIIS_DOSEMU_TARGET_DOS_PATH");
 	if (!target || !*target ||
diff --git a/src/base/lib/mapping/mapping.h b/src/base/lib/mapping/mapping.h
--- a/src/base/lib/mapping/mapping.h
+++ b/src/base/lib/mapping/mapping.h
@@ -137,6 +137,7 @@ extern int have_mremap_fixed;
 
 void mapping_init(void);
 void mapping_close(void);
+int mapping_validator_lowmem_export_ready(void);
 
 #ifdef __linux__
 void init_hardware_ram(void);
diff --git a/src/base/lib/mapping/mapping.c b/src/base/lib/mapping/mapping.c
--- a/src/base/lib/mapping/mapping.c
+++ b/src/base/lib/mapping/mapping.c
@@ -92,6 +92,8 @@ static struct mappingdrivers *mappingdriver;
 static const struct mapping_hook *mapping_hook;
 
 #define ALIAS_SIZE (LOWMEM_SIZE + HMASIZE)
+int mapfile_validator_lowmem_export_ready(void *addr, size_t size);
+
 static unsigned char *lowmem_aliasmap[ALIAS_SIZE/PAGE_SIZE];
 struct hardware_ram;
 static dosaddr_t do_get_hardware_ram(unsigned addr, uint32_t size,
@@ -153,6 +155,22 @@ void *physaddr_to_unixaddr(unsigned int addr)
   return MAP_FAILED;
 }
 
+int mapping_validator_lowmem_export_ready(void)
+{
+#ifdef HAVE_SHM_OPEN
+  if (mappingdriver != &mappingdriver_shm)
+    return 0;
+  if (!lowmem_base)
+    return 0;
+  if (!mapfile_validator_lowmem_export_ready(lowmem_base, ALIAS_SIZE))
+    return 0;
+  /* Conventional address zero must resolve through the exported backing. */
+  return dosaddr_to_unixaddr(0) == lowmem_base;
+#else
+  return 0;
+#endif
+}
+
 dosaddr_t physaddr_to_dosaddr(unsigned int addr, int len)
 {
   dosaddr_t ret = get_hardware_ram(addr, len);
diff --git a/src/base/lib/mapping/mapfile.c b/src/base/lib/mapping/mapfile.c
--- a/src/base/lib/mapping/mapfile.c
+++ b/src/base/lib/mapping/mapfile.c
@@ -48,4 +48,28 @@ struct mfops_s {
 static struct mfops_s *mfops;
+
+#define DIIS_LOWMEM_SHM_NAME "/dosemu_mem"
+static int validator_lowmem_named;
+static int validator_lowmem_verified;
+static void *validator_lowmem_addr;
+static size_t validator_lowmem_size;
+
+static int validator_requested(void)
+{
+  const char *s = getenv("DIIS_DOSEMU_VALIDATOR");
+  return s && strcmp(s, "1") == 0;
+}
+
+static void validator_lowmem_reset(void)
+{
+#ifdef HAVE_SHM_OPEN
+  if (validator_lowmem_named)
+    shm_unlink(DIIS_LOWMEM_SHM_NAME);
+#endif
+  validator_lowmem_named = 0;
+  validator_lowmem_verified = 0;
+  validator_lowmem_addr = NULL;
+  validator_lowmem_size = 0;
+}
 
 static struct file_mapping *find_file_mapping(unsigned char *target)
 {
@@ -213,6 +237,9 @@ static void do_free_mapping(struct file_mapping *p)
 {
+  if (p->addr == validator_lowmem_addr)
+    validator_lowmem_reset();
+
   munmap(p->addr, p->size);
   if (p->fd != -1)
     close(p->fd);
@@ -260,5 +287,38 @@ static void *alloc_tail(int fd, size_t mapsize, int prot, void *target)
   p->prot = prot;
   return target;
 }
 
+static int verify_validator_lowmem_fd(int fd, unsigned char *addr,
+    size_t mapsize)
+{
+  unsigned char *probe;
+  unsigned char old0, old1;
+
+  if (mapsize < PAGE_SIZE || mapsize < 2)
+    return 0;
+  probe = mmap(NULL, PAGE_SIZE, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+  if (probe == MAP_FAILED)
+    return 0;
+
+  old0 = addr[0];
+  old1 = addr[1];
+  addr[0] = old0 ^ 0x5a;
+  if (probe[0] != addr[0])
+    goto fail;
+  probe[1] = old1 ^ 0xa5;
+  if (addr[1] != probe[1])
+    goto fail;
+
+  addr[0] = old0;
+  addr[1] = old1;
+  munmap(probe, PAGE_SIZE);
+  return 1;
+
+fail:
+  addr[0] = old0;
+  addr[1] = old1;
+  munmap(probe, PAGE_SIZE);
+  return 0;
+}
+
 static void *alloc_mapping_file(int cap, size_t mapsize, void *target)
@@ -266,17 +326,74 @@ static void *alloc_mapping_file(int cap, size_t mapsize, void *target)
 {
   int prot = PROT_READ | PROT_WRITE;
   int fd, rc;
+  void *addr;
+  int validator_lowmem = validator_requested() && (cap & MAPPING_LOWMEM);
 
   Q__printf("MAPPING: alloc, cap=%s, mapsize=%zx\n", cap, mapsize);
-  fd = mfops->open();
+#ifdef HAVE_SHM_OPEN
+  if (validator_lowmem) {
+    if (mfops != &pshm_mfops) {
+      error("DIIS validator low memory requires mapshm\n");
+      errno = EINVAL;
+      return MAP_FAILED;
+    }
+    fd = shm_open(DIIS_LOWMEM_SHM_NAME,
+        O_RDWR | O_CREAT | O_EXCL, S_IRUSR | S_IWUSR);
+    if (fd != -1)
+      validator_lowmem_named = 1;
+  } else
+#endif
+  {
+#ifndef HAVE_SHM_OPEN
+    if (validator_lowmem) {
+      error("DIIS validator low memory requires POSIX shm_open support\n");
+      errno = ENOTSUP;
+      return MAP_FAILED;
+    }
+#endif
+    fd = mfops->open();
+  }
+
   if (fd < 0) {
     error("mapping: open() failed\n");
     return MAP_FAILED;
   }
   rc = ftruncate(fd, mapsize);
-  assert(rc != -1);
-  return alloc_tail(fd, mapsize, prot, target);
+  if (rc == -1) {
+    error("mapping: ftruncate() failed: %s\n", strerror(errno));
+    close(fd);
+    if (validator_lowmem)
+      validator_lowmem_reset();
+    return MAP_FAILED;
+  }
+  addr = alloc_tail(fd, mapsize, prot, target);
+  if (addr == MAP_FAILED) {
+    close(fd);
+    if (validator_lowmem)
+      validator_lowmem_reset();
+    return MAP_FAILED;
+  }
+
+  if (validator_lowmem) {
+    validator_lowmem_addr = addr;
+    validator_lowmem_size = mapsize;
+    if (!validator_lowmem_named ||
+        !verify_validator_lowmem_fd(fd, addr, mapsize)) {
+      error("DIIS validator low-memory shared backing verification failed\n");
+      do_free_mapping(find_file_mapping(addr));
+      errno = EIO;
+      return MAP_FAILED;
+    }
+    validator_lowmem_verified = 1;
+  }
+  return addr;
 }
+
+int mapfile_validator_lowmem_export_ready(void *addr, size_t size)
+{
+  return validator_lowmem_named && validator_lowmem_verified &&
+      validator_lowmem_addr == addr && validator_lowmem_size == size;
+}
 
 static void *attach_mapping_file(int fd, size_t mapsize, int prot)
 {
