From 7a52b8235575b61444c65a57c24116a4ed82d7df Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 10 Aug 2026 14:05:26 +0000
Subject: [PATCH] simx86: classify only architectural exceptions as faults

Validator-controlled nodes set MSSTP, so their expected instruction boundary reports EXCP01_SSTP through TheCPU.err. The same field also carries simx86 internal return reasons. Expose only the architectural exception range as a guest FAULT, excluding the requested single-step boundary.
---
 src/base/emu-i386/simx86/diis-validator.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/base/emu-i386/simx86/diis-validator.c b/src/base/emu-i386/simx86/diis-validator.c
index 11f3fb32a..f916c8447 100644
--- a/src/base/emu-i386/simx86/diis-validator.c
+++ b/src/base/emu-i386/simx86/diis-validator.c
@@ -484,7 +484,11 @@ void diis_validator_after_node(unsigned int start_pc, unsigned int next_pc,
 		flags |= DIIS_STEP_MULTI_INSN;
 	if (next_pc == start_pc)
 		flags |= DIIS_STEP_SAME_PC;
-	if (cpu_err)
+	/* TheCPU.err also carries simx86-internal return reasons (EXCP_GOBACK and
+	 * above).  Publish only architectural exceptions, excluding the MSSTP
+	 * boundary deliberately requested for validator-controlled execution. */
+	if (cpu_err >= EXCP00_DIVZ && cpu_err <= EXCP12_MCHK &&
+			cpu_err != EXCP01_SSTP)
 		flags |= DIIS_STEP_FAULT;
 
 	publish_cpu(next_pc, decoded_instructions, flags);
