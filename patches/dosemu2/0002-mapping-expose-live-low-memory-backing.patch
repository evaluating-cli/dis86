From bccdd8e321eb30ec465f8714ff2a53a372c3c522 Mon Sep 17 00:00:00 2001
From: maint <no@invalid>
Date: Thu, 13 Aug 2026 17:53:34 +0000
Subject: [PATCH] mapping: expose live low-memory backing for external
 validation

---
 src/base/emu-i386/simx86/diis-validator.c |  8 +++++
 src/base/lib/mapping/mapfile.c            | 36 +++++++++++++++++++++--
 src/base/lib/mapping/mapping.c            | 18 ++++++++++++
 src/base/lib/mapping/mapping.h            | 10 +++++++
 4 files changed, 70 insertions(+), 2 deletions(-)

diff --git a/src/base/emu-i386/simx86/diis-validator.c b/src/base/emu-i386/simx86/diis-validator.c
index eaff089dc..a397c4d97 100644
--- a/src/base/emu-i386/simx86/diis-validator.c
+++ b/src/base/emu-i386/simx86/diis-validator.c
@@ -14,6 +14,7 @@
 #include "codegen.h"
 #include "diis-validator.h"
 #include "memory.h"
+#include "mapping/mapping.h"
 #include "protmode.h"
 #include "utilities.h"
 
@@ -109,6 +110,7 @@ static int parse_u16_env(const char *name, uint16_t *out)
 
 static int diis_validator_init(void)
 {
+	struct mapping_backing backing;
 	const char *enabled;
 	const char *target;
 	long page_size;
@@ -126,6 +128,12 @@ static int diis_validator_init(void)
 		error("DIIS validator requires $_cpuemu = (1)\n");
 		return 0;
 	}
+	if (!mapping_get_lowmem_backing(&backing) ||
+		backing.kind != MAPPING_BACKING_POSIX_SHM ||
+		!backing.name || strcmp(backing.name, "/dosemu_mem")) {
+		error("DIIS validator requires live mapshm low memory at /dosemu_mem\n");
+		return 0;
+	}
 
 	target = getenv("DIIS_DOSEMU_TARGET_DOS_PATH");
 	if (!target || !*target ||
diff --git a/src/base/lib/mapping/mapfile.c b/src/base/lib/mapping/mapfile.c
index 8525d1ce0..033564c3a 100644
--- a/src/base/lib/mapping/mapfile.c
+++ b/src/base/lib/mapping/mapfile.c
@@ -49,6 +49,7 @@ static struct file_mapping {
   size_t fsize;
   int fd;
   int prot;
+  char *name;
 } file_mappings[MAX_FILE_MAPPINGS];
 
 typedef int (*open_cb_t)(void);
@@ -57,6 +58,7 @@ struct mfops_s {
 };
 
 static struct mfops_s *mfops;
+static const char *next_mapping_name;
 
 static struct file_mapping *find_file_mapping(unsigned char *target)
 {
@@ -70,6 +72,20 @@ static struct file_mapping *find_file_mapping(unsigned char *target)
   return p;
 }
 
+void mapfile_set_next_mapping_name(const char *name) { next_mapping_name = name; }
+
+int mapfile_query_mapping(void *addr, struct mapping_backing *backing)
+{
+  struct file_mapping *p = find_file_mapping(addr);
+  if (p->addr != addr) return 0;
+  backing->kind = p->name ? MAPPING_BACKING_POSIX_SHM : MAPPING_BACKING_UNKNOWN;
+  backing->fd = p->fd;
+  backing->name = p->name;
+  backing->base = p->addr;
+  backing->size = p->size;
+  return 1;
+}
+
 /* Do not create mapping nodes for aliases, so can't alias the alias.
  * This is the simplest design. */
 static void *alias_mapping_file(int cap, void *target, size_t mapsize, int protect, void *source)
@@ -207,6 +223,11 @@ static int open_mapping_mshm(int cap)
 
 static void do_free_mapping(struct file_mapping *p)
 {
+#ifdef HAVE_SHM_OPEN
+  if (p->name) shm_unlink(p->name);
+#endif
+  free(p->name);
+  p->name = NULL;
   munmap(p->addr, p->size);
   if (p->fd != -1)
     close(p->fd);
@@ -267,14 +288,25 @@ static void *alloc_mapping_file(int cap, size_t mapsize, void *target)
   int fd, rc;
 
   Q__printf("MAPPING: alloc, cap=%s, mapsize=%zx\n", cap, mapsize);
-  fd = mfops->open();
+#ifdef HAVE_SHM_OPEN
+  if (next_mapping_name) {
+    if (mfops != &pshm_mfops) { errno = ENOTSUP; return MAP_FAILED; }
+    fd = shm_open(next_mapping_name, O_RDWR | O_CREAT | O_EXCL,
+        S_IRUSR | S_IWUSR);
+  } else
+#endif
+    fd = mfops->open();
   if (fd < 0) {
     error("mapping: open() failed\n");
     return MAP_FAILED;
   }
   rc = ftruncate(fd, mapsize);
   assert(rc != -1);
-  return alloc_tail(fd, mapsize, prot, target);
+  target = alloc_tail(fd, mapsize, prot, target);
+  if (target != MAP_FAILED && next_mapping_name)
+    find_file_mapping(target)->name = strdup(next_mapping_name);
+  next_mapping_name = NULL;
+  return target;
 }
 
 static void *attach_mapping_file(int fd, size_t mapsize, int prot)
diff --git a/src/base/lib/mapping/mapping.c b/src/base/lib/mapping/mapping.c
index 0a81af473..1ec9d3ed1 100644
--- a/src/base/lib/mapping/mapping.c
+++ b/src/base/lib/mapping/mapping.c
@@ -99,6 +99,8 @@ static struct mappingdrivers *mappingdriver;
 static const struct mapping_hook *mapping_hook;
 
 #define ALIAS_SIZE (LOWMEM_SIZE + HMASIZE)
+void mapfile_set_next_mapping_name(const char *name);
+int mapfile_query_mapping(void *addr, struct mapping_backing *backing);
 static unsigned char *lowmem_aliasmap[ALIAS_SIZE/PAGE_SIZE];
 struct hardware_ram;
 static dosaddr_t do_get_hardware_ram(unsigned addr, uint32_t size,
@@ -163,6 +165,13 @@ void *physaddr_to_unixaddr(unsigned int addr)
   return MAP_FAILED;
 }
 
+int mapping_get_lowmem_backing(struct mapping_backing *backing)
+{
+  if (!lowmem_base || !mapfile_query_mapping(lowmem_base, backing)) return 0;
+  return backing->base == lowmem_base && backing->size >= ALIAS_SIZE &&
+      dosaddr_to_unixaddr(0) == lowmem_base;
+}
+
 dosaddr_t physaddr_to_dosaddr(unsigned int addr, int len)
 {
   dosaddr_t ret = get_hardware_ram(addr, len);
@@ -621,6 +630,15 @@ void close_mapping(int cap)
 
 static void *do_alloc_mapping(int cap, size_t mapsize, void *addr)
 {
+  const char *validator = getenv("DIIS_DOSEMU_VALIDATOR");
+  if ((cap & MAPPING_LOWMEM) && validator && !strcmp(validator, "1")) {
+    if (mappingdriver != &mappingdriver_shm) {
+      error("DIIS validator low memory requires mapshm\n");
+      exit(2);
+      return NULL;
+    }
+    mapfile_set_next_mapping_name("/dosemu_mem");
+  }
   addr = mappingdriver->alloc(cap, mapsize, addr);
   if (addr == MAP_FAILED) {
     error("failed to alloc %zx\n", mapsize);
diff --git a/src/base/lib/mapping/mapping.h b/src/base/lib/mapping/mapping.h
index cf82c1e0b..464ba34ac 100644
--- a/src/base/lib/mapping/mapping.h
+++ b/src/base/lib/mapping/mapping.h
@@ -163,8 +163,18 @@ extern struct mappingdrivers mappingdriver_file;
 
 extern int have_mremap_fixed;
 
+enum mapping_backing_kind { MAPPING_BACKING_UNKNOWN, MAPPING_BACKING_POSIX_SHM };
+struct mapping_backing {
+  enum mapping_backing_kind kind;
+  int fd;
+  const char *name;
+  void *base;
+  size_t size;
+};
+
 void mapping_init(void);
 void mapping_close(void);
+int mapping_get_lowmem_backing(struct mapping_backing *backing);
 
 #ifdef __linux__
 void init_hardware_ram(void);
-- 
2.43.0

