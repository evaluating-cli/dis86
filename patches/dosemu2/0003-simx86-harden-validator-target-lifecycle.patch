From 0000000000000000000000000000000000000003 Mon Sep 17 00:00:00 2001
From: evaluating-cli <noreply@github.com>
Date: Sun, 9 Aug 2026 17:52:00 +0200
Subject: [PATCH 3/3] simx86: harden validator target lifecycle

Use dosemu's version-adjusted SDA current-PSP accessor to scope validator
stepping to the captured target process. Descendant PSPs are treated as child
or helper processes and run without consuming validator requests. Once the
DOS current PSP leaves the captured target's PSP ancestry, permanently mark
the target finished, clear runtime_psp, and acknowledge any pending request
with DIIS_STEP_TARGET_EXIT.

The exact entry gate now also requires the candidate PSP to equal dosemu's
current PSP, so a stale PSP-shaped block cannot activate the hook.

The PSP parent walk uses dosemu's own struct PSP layout rather than a literal
DOS offset. A bounded walk prevents malformed/cyclic parent chains from being
accepted as descendants.

Base: patch 2 on dosemu2/dosemu2@604ce0cdd1a71f657e2a2df623d216d5ab289313
---
diff --git a/src/base/emu-i386/simx86/diis-validator.h b/src/base/emu-i386/simx86/diis-validator.h
--- a/src/base/emu-i386/simx86/diis-validator.h
+++ b/src/base/emu-i386/simx86/diis-validator.h
@@ -7,5 +7,6 @@ enum {
 	DIIS_STEP_MULTI_INSN = 1u << 0,
 	DIIS_STEP_SAME_PC = 1u << 1,
 	DIIS_STEP_FAULT = 1u << 2,
 	DIIS_STEP_END_ACK = 1u << 3,
+	DIIS_STEP_TARGET_EXIT = 1u << 4,
 };
diff --git a/src/base/emu-i386/simx86/diis-validator.c b/src/base/emu-i386/simx86/diis-validator.c
--- a/src/base/emu-i386/simx86/diis-validator.c
+++ b/src/base/emu-i386/simx86/diis-validator.c
@@ -9,4 +9,5 @@
 #include <sys/stat.h>
 #include <unistd.h>
 
+#include "dos2linux.h"
 #include "emu86.h"
@@ -61,5 +62,7 @@ static int g_config_checked;
 static int g_enabled;
 static int g_created;
 static int g_active;
+static int g_target_finished;
+static int g_node_controlled;
 static uint16_t g_mz_cs;
 static uint16_t g_mz_ip;
@@ -223,3 +226,53 @@ static int psp_program_identity_matches(uint16_t psp)
 }
 
+static uint16_t current_psp(void)
+{
+	if (!sda)
+		return 0;
+	return sda_cur_psp(sda);
+}
+
+static int psp_is_descendant_of(uint16_t psp, uint16_t ancestor)
+{
+	unsigned int depth;
+
+	for (depth = 0; depth < 64; depth++) {
+		dosaddr_t parent_addr;
+		uint16_t parent;
+
+		if (!psp)
+			return 0;
+		if (psp == ancestor)
+			return 1;
+		parent_addr = ((dosaddr_t)psp << 4) +
+			offsetof(struct PSP, parent_psp);
+		if (parent_addr + sizeof(uint16_t) > LOWMEM_SIZE + HMASIZE)
+			return 0;
+		parent = LOWMEM_READ_WORD(parent_addr);
+		if (!parent || parent == psp)
+			return 0;
+		psp = parent;
+	}
+	return 0;
+}
+
+static void mark_target_finished(void)
+{
+	uint64_t req;
+
+	if (g_target_finished)
+		return;
+	g_active = 0;
+	g_target_finished = 1;
+	g_node_controlled = 0;
+	g_runtime_psp = 0;
+	if (!g_shm)
+		return;
+	g_shm->runtime_psp = 0;
+	g_shm->decoded_instructions = 0;
+	g_shm->step_flags = DIIS_STEP_TARGET_EXIT;
+	req = __atomic_load_n(&g_shm->req, __ATOMIC_RELAXED);
+	__atomic_store_n(&g_shm->ack, req, __ATOMIC_RELEASE);
+}
+
 static int target_entry_matches(unsigned int pc)
@@ -238,2 +291,4 @@ static int target_entry_matches(unsigned int pc)
 	psp = TheCPU.ds;
+	if (current_psp() != psp)
+		return 0;
 	ip = (uint16_t)(pc - LONG_CS);
@@ -301,7 +356,11 @@ int diis_validator_before_node(unsigned int *pc)
 	uint64_t req;
 	uint64_t ack;
+	uint16_t psp;
 
 	if (!diis_validator_init())
 		return 0;
+	g_node_controlled = 0;
+	if (g_target_finished)
+		return 0;
 
 	if (!g_active) {
@@ -316,8 +375,19 @@ int diis_validator_before_node(unsigned int *pc)
 	for (;;) {
 		if (__atomic_load_n(&g_shm->end, __ATOMIC_ACQUIRE)) {
 			publish_cpu(*pc, 0, DIIS_STEP_END_ACK);
 			req = __atomic_load_n(&g_shm->req, __ATOMIC_RELAXED);
 			__atomic_store_n(&g_shm->ack, req, __ATOMIC_RELEASE);
 			return -1;
 		}
+		psp = current_psp();
+		if (!psp) {
+			mark_target_finished();
+			return 0;
+		}
+		if (psp != g_runtime_psp) {
+			if (psp_is_descendant_of(psp, g_runtime_psp))
+				return 0;
+			mark_target_finished();
+			return 0;
+		}
 		req = __atomic_load_n(&g_shm->req, __ATOMIC_ACQUIRE);
@@ -331,3 +401,4 @@ int diis_validator_before_node(unsigned int *pc)
 	apply_cpu(pc);
+	g_node_controlled = 1;
 	return 1;
 }
@@ -340,6 +411,7 @@ void diis_validator_after_node(unsigned int start_pc, unsigned int next_pc,
 	uint32_t flags = 0;
 	uint64_t req;
 
-	if (!g_active)
+	if (!g_active || !g_node_controlled)
 		return;
+	g_node_controlled = 0;
 	if (decoded_instructions > 1)
-- 
