From e4aab5866894eb0a6c725c6167791586c5ea251c Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 10 Aug 2026 13:46:54 +0000
Subject: [PATCH] simx86: allow dynamic target drive identity

The -K mount consumes the next available redirected DOS drive rather than always using C:. Accept an explicit question-mark wildcard for only the canonical path drive letter so the validator can identify its target across boot stacks.
---
 src/base/emu-i386/simx86/diis-validator.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/base/emu-i386/simx86/diis-validator.c b/src/base/emu-i386/simx86/diis-validator.c
index ad66a06d5..11f3fb32a 100644
--- a/src/base/emu-i386/simx86/diis-validator.c
+++ b/src/base/emu-i386/simx86/diis-validator.c
@@ -190,7 +190,11 @@ static int guest_path_matches(dosaddr_t addr)
 		unsigned char guest = LOWMEM_READ_BYTE(addr + i);
 		unsigned char expected = (unsigned char)g_target_dos_path[i];
 
-		if (norm_path_char(guest) != norm_path_char(expected))
+		/* -K uses the next free redirected drive, which depends on the
+		 * selected DOS boot stack.  Permit an explicit drive wildcard while
+		 * retaining an exact match for the rest of the canonical path. */
+		if (!(i == 0 && expected == '?' && isalpha(guest)) &&
+				norm_path_char(guest) != norm_path_char(expected))
 			return 0;
 		if (!guest)
 			return expected == 0;
-- 
